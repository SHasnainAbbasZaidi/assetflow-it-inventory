# Existing installations: preserve your current .env and database; do not overwrite them.
# Relative SQLite paths resolve against server/prisma. Prefer an absolute persistent path in production.
DATABASE_URL="file:./dev.db"
PORT=3000
JWT_SECRET=""
# New installations only; db:init refuses existing files.
INITIAL_ADMIN_EMAIL="admin@assetflow.local"
INITIAL_ADMIN_PASSWORD=""
# Optional: absolute persistent paths outside a replaceable deployment directory.
# BACKUP_ROOT="/var/lib/assetflow/backups"
# AI_KEY_FILE="/var/lib/assetflow/.assetflow-ai.key"
